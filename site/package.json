{
  "name": "aquavena-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "a11y": "astro preview --port 4321 & sleep 3 && pa11y-ci --config .pa11yci.json; STATUS=$?; astro preview stop; exit $STATUS",
    "report": "bun run build && node report.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@tailwindcss/vite": "^4.3.1",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^7.3.3",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "pa11y": "^10.0.0",
    "pa11y-ci": "^4.1.1"
  }
}
